{
  "expo": {
    "name": "Auverion Systems",
    "slug": "auverion-systems",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "auverion",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auverion.systems"
    },
    "android": {
      "package": "com.auverion.systems",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Auverion Systems",
      "shortName": "Auverion",
      "description": "Precision-engineered digital infrastructure for teams building what comes next.",
      "lang": "en",
      "themeColor": "#000000",
      "backgroundColor": "#000000",
      "display": "standalone",
      "orientation": "landscape-primary",
      "preferRelatedApplications": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-web-browser",
        {
          "scheme": "auverion"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "font": {
      "fonts": [
        "./assets/fonts/IBMPlexSans-Regular.ttf",
        "./assets/fonts/IBMPlexSans-Medium.ttf",
        "./assets/fonts/IBMPlexSans-SemiBold.ttf",
        "./assets/fonts/IBMPlexSans-Bold.ttf",
        "./assets/fonts/IBMPlexMono-Regular.ttf"
      ]
    }
  }
}